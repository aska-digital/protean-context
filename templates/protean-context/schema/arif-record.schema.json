{
  "schema": "arif-record-v1",
  "schemaVersion": 1,
  "title": "Arif metadata-first record",
  "description": "One record file: identity, source, content reference, metadata, provenance, and the embedding field. Readers answer source, topic, and provenance questions from metadata without loading content blobs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "source", "content", "metadata",
               "provenance", "embedding"],
  "properties": {
    "schema": {"type": "string", "const": "arif-record-v1"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "locator", "kind", "retrieved"],
      "properties": {
        "title": {"type": "string"},
        "locator": {"type": "string"},
        "kind": {"type": "string", "enum": ["document", "web", "note", "other"]},
        "retrieved": {"type": ["string", "null"]}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "mediaType", "checksum", "bytes"],
      "properties": {
        "ref": {"type": "string", "pattern": "^content/[0-9a-f]{64}$"},
        "mediaType": {"type": "string"},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "metadata": {
      "type": "object",
      "required": ["topics", "tags", "language", "license"],
      "properties": {
        "topics": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "language": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "ingestedAt", "method"],
      "properties": {
        "adapter": {"type": "string"},
        "ingestedAt": {"type": ["string", "null"]},
        "method": {"type": "string"}
      }
    },
    "embedding": {"type": ["array", "null"]}
  }
}
